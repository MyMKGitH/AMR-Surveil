{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MyMKGitH/amr-surveil/schemas/incidence.schema.json",
  "title": "AMR-Surveil: Population-based resistant-infection counts",
  "type": "object",
  "required": [
    "year",
    "country",
    "organism",
    "antimicrobial",
    "resistant_infection_n",
    "population_n",
    "source_name",
    "case_definition"
  ],
  "properties": {
    "year": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "source_sector": {
      "type": [
        "string",
        "null"
      ]
    },
    "organism": {
      "type": "string",
      "minLength": 1
    },
    "antimicrobial": {
      "type": "string",
      "minLength": 1
    },
    "resistant_infection_n": {
      "type": "string",
      "minLength": 1
    },
    "population_n": {
      "type": "string",
      "minLength": 1
    },
    "population_multiplier": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "case_definition": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
